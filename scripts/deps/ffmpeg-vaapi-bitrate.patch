diff --git a/libavcodec/vaapi_encode.c b/libavcodec/vaapi_encode.c
index 0e50602..3930acc 100644
--- a/libavcodec/vaapi_encode.c
+++ b/libavcodec/vaapi_encode.c
@@ -346,6 +346,29 @@ static int vaapi_encode_issue(AVCodecContext *avctx,
             goto fail;
     }
 
+    if (ctx->rc_mode && ctx->rc_mode->bitrate && ctx->rc_bit_rate &&
+        avctx->bit_rate != ctx->rc_bit_rate) {
+        ctx->rc_params.bits_per_second = avctx->rc_max_rate > avctx->bit_rate ? avctx->rc_max_rate : avctx->bit_rate;
+        if (avctx->rc_buffer_size > 0) {
+            ctx->hrd_params.buffer_size = avctx->rc_buffer_size;
+            ctx->hrd_params.initial_buffer_fullness = avctx->rc_buffer_size * 3 / 4;
+        }
+        ctx->rc_bit_rate = avctx->bit_rate;
+        if (base_pic->type != FF_HW_PICTURE_TYPE_IDR) {
+            for (i = 0; i < ctx->nb_global_params; i++) {
+                if (ctx->global_params_type[i] != VAEncMiscParameterTypeRateControl &&
+                    ctx->global_params_type[i] != VAEncMiscParameterTypeHRD)
+                    continue;
+                err = vaapi_encode_make_misc_param_buffer(avctx, pic,
+                                                          ctx->global_params_type[i],
+                                                          ctx->global_params[i],
+                                                          ctx->global_params_size[i]);
+                if (err < 0)
+                    goto fail;
+            }
+        }
+    }
+
     if (base_pic->type == FF_HW_PICTURE_TYPE_IDR) {
         for (i = 0; i < ctx->nb_global_params; i++) {
             err = vaapi_encode_make_misc_param_buffer(avctx, pic,
@@ -1538,6 +1561,7 @@ rc_mode_found:
                                       VAEncMiscParameterTypeRateControl,
                                       &ctx->rc_params,
                                       sizeof(ctx->rc_params));
+        ctx->rc_bit_rate = avctx->bit_rate;
     }
 
     if (rc_mode->hrd) {
