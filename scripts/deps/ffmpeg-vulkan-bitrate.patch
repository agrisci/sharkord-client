diff --git a/libavcodec/vulkan_encode.c b/libavcodec/vulkan_encode.c
index 39c4330..7dbb196 100644
--- a/libavcodec/vulkan_encode.c
+++ b/libavcodec/vulkan_encode.c
@@ -166,8 +166,9 @@ static int vulkan_encode_issue(AVCodecContext *avctx,
         .sType = VK_STRUCTURE_TYPE_VIDEO_END_CODING_INFO_KHR,
     };
 
-    VkVideoEncodeRateControlLayerInfoKHR rc_layer;
-    VkVideoEncodeRateControlInfoKHR rc_info;
+    VkVideoEncodeRateControlLayerInfoKHR rc_layer, rc_layer_prev;
+    VkVideoEncodeRateControlInfoKHR rc_info, rc_info_prev;
+    int rc_change;
     VkVideoEncodeQualityLevelInfoKHR q_info;
     VkVideoCodingControlInfoKHR encode_ctrl;
 
@@ -193,6 +194,18 @@ static int vulkan_encode_issue(AVCodecContext *avctx,
     if (err < 0)
         return err;
 
+    /* A bitrate change after the session started: begin with the state the session has, then
+     * send the new one alone (no reset, so no IDR) */
+    rc_change = ctx->session_reset &&
+                (avctx->bit_rate != ctx->rc_bit_rate || avctx->rc_max_rate != ctx->rc_max_rate);
+    if (rc_change) {
+        rc_layer_prev = rc_layer;
+        rc_layer_prev.averageBitrate = ctx->rc_bit_rate;
+        rc_layer_prev.maxBitrate = ctx->rc_max_rate ? ctx->rc_max_rate : ctx->rc_bit_rate;
+        rc_info_prev = rc_info;
+        rc_info_prev.pLayers = &rc_layer_prev;
+    }
+
     q_info = (VkVideoEncodeQualityLevelInfoKHR) {
         .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_QUALITY_LEVEL_INFO_KHR,
         .pNext = &rc_info,
@@ -275,7 +288,7 @@ static int vulkan_encode_issue(AVCodecContext *avctx,
 
     encode_start = (VkVideoBeginCodingInfoKHR) {
         .sType = VK_STRUCTURE_TYPE_VIDEO_BEGIN_CODING_INFO_KHR,
-        .pNext = !base_pic->force_idr ? &rc_info : NULL,
+        .pNext = !base_pic->force_idr ? (rc_change ? &rc_info_prev : &rc_info) : NULL,
         .videoSession = ctx->common.session,
         .videoSessionParameters = ctx->session_params,
         .referenceSlotCount = encode_info.referenceSlotCount + 1,
@@ -419,7 +432,16 @@ static int vulkan_encode_issue(AVCodecContext *avctx,
     if (!ctx->session_reset) {
         vk->CmdControlVideoCodingKHR(cmd_buf, &encode_ctrl);
         ctx->session_reset++;
+    } else if (rc_change) {
+        VkVideoCodingControlInfoKHR rc_ctrl = {
+            .sType = VK_STRUCTURE_TYPE_VIDEO_CODING_CONTROL_INFO_KHR,
+            .pNext = &rc_info,
+            .flags = VK_VIDEO_CODING_CONTROL_ENCODE_RATE_CONTROL_BIT_KHR,
+        };
+        vk->CmdControlVideoCodingKHR(cmd_buf, &rc_ctrl);
     }
+    ctx->rc_bit_rate = avctx->bit_rate;
+    ctx->rc_max_rate = avctx->rc_max_rate;
 
     /* Encode */
     vk->CmdBeginQuery(cmd_buf, ctx->enc_pool.query_pool, exec->query_idx + 0, 0);
